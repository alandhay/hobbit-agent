# Copy to deploy/hobbit.env (never committed) and fill in. deploy/push.sh sends it to the server,
# where only root and systemd can read it.

# Anthropic API key (console.anthropic.com). Set a monthly spend limit on the account too.
ANTHROPIC_API_KEY=

# YouTube Studio -> Create -> Go live -> Stream key. Leave empty to run without streaming.
YOUTUBE_STREAM_KEY=

# The password for the control buttons on the dashboard (https://<ip>.sslip.io/?operator).
# Left empty, deploy/push.sh makes a random one and writes it here.
HOBBIT_OPERATOR_PASSWORD=
